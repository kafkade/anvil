{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workload Schema",
  "type": "object",
  "required": ["name", "description", "packages"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the workload"
    },
    "description": {
      "type": "string",
      "description": "Description of the workload"
    },
    "packages": {
      "type": "object",
      "description": "List of winget packages to install. Use 'winget search' to find package IDs.",
      "additionalProperties": {
        "type": "array",
        "description": "List of package IDs to install from the specified source",
        "items": {
          "type": "string"
        }
      }
    },
    "scripts": {
      "type": "object",
      "description": "List of scripts to run as part of the workload",
      "additionalProperties": {
        "type": "array",
        "description": "List of script paths to run",
        "items": {
          "type": "string"
        }
      }
    },
    "environmentVariables": {
      "type": "object",
      "description": "Environment variables to set",
      "additionalProperties": {
        "type": "string"
      }
    },
    "folders": {
      "type": "array",
      "description": "Folders to create",
      "items": {
        "type": "string"
      }
    },
    "downloads": {
      "type": "array",
      "description": "Files to download",
      "items": {
        "type": "object",
        "required": ["uri", "destination"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "destination": {
            "type": "string"
          }
        }
      }
    }
  }
}