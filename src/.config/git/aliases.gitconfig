### git aliases

[alias]
    abort = rebase --abort
    aliases = "!git config -l | grep ^alias\\. | cut -c 7-"

    s = status -s

    ### Shows the commit message and files changed from the latest commit
    latest = "!git ll -1"

    gr = grep -Ii

    lost = fsck --lost-found

    ### A better git log.
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ls-subtrees = !"git log | grep git-subtree-dir | awk '{ print $2 }'"
    l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=human
    h = log --graph --decorate --abbrev-commit --date=human --oneline --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
    hist = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    history = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    graph = log --graph -10 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset• %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
    cake = log --date=format:'%d %b %Y' --diff-filter=A --name-only --pretty='%n%C(yellow bold)🎂️ %ad%Creset by (%C(blue bold)%h%Creset)'


    ### Show list of files in a conflict state.
    conflicts = !git diff --name-only --diff-filter=U

    diff = diff --word-diff
    d = diff --word-diff
    dc = diff --cached

    ### diff last commit
    dlc = diff --word-diff --cached HEAD^

    ai = add --patch
    ri = restore --patch
    
    ### grep on filename
    f = "!git ls-files | grep -i"

    ### Opens this config file
    ec = config --global -e
    
    ### Pulls changes from remote. Rebases local commits. Prunes branches deleted on the remote
    up = !git pull --rebase --prune $@ && git submodule update --init --recursive

    ### Stages every file then creates a commit with specified message
    cm = !git add -A && git commit -m

    ### Checks out a branch
    co = checkout

    ### Creates new branch
    cob = checkout -b

    ### Lists the files with the most churn
    churn = !git --no-pager log --name-only --oneline | grep -v ' ' | sort | uniq -c | sort -nr | head

    ### Reset aliases
    r1 = reset HEAD^
    r2 = reset HEAD^^
    rh = reset --hard
    rh1 = reset HEAD^ --hard
    rh2 = reset HEAD^^ --hard    

    ### Commit with message
    cm = !git commit -m

    ### Saves everything including untracked changes to a commit w/ message SAVEPOINT.
    ### This is better than stash it. You can always undo it.
    save = !git add -A && git commit -m 'SAVEPOINT'

    ### Discard changes to a file
    discard = checkout --

    ### Commits changes w/ message WIP.
    ### This is better than stash it. You can always undo it.
    wip = commit -am 'WIP'

    ### Resets previous commit. Keeps changes from that commit in the working directory
    undo = reset HEAD~1 --mixed

    ### Sync working directory with remote branch
    sync = !git pull --rebase && git push

    ### Modifies previous commit with changes and deletion (ignores new files)
    amend = commit -a --amend

    ### Same as 'amend' but without changes to commit message
    amendsilent = commit -a --amend --no-edit

    ### Get default branch name
    default = !git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'    

    ### List branches
    branches = branch -a    #all
    bra = branch -ra        #remote
    brl = branch -l         #local


    # Unstage a file
    unstage = reset -q HEAD --

    up = !git pull --rebase --prune $@ && git submodule update --init --recursive

    ### Commits everything in working directory and then does a hard reset to remove that commit
    ### This is better than just doing a hard reset when you want to toss work in progress
    # v1
    #wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
    # v2
    wipe = "!f() { rev=$(git rev-parse ${1-HEAD}); git add -A && git commit --allow-empty -qm 'WIPE SAVEPOINT' && git reset $rev --hard; }; f"

    ### Lists branches that have an upstream branch that has been deleted
    gone = !git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/ | awk '$2 == \"[gone]\" { print $1 }'

    #### Deletes all branches merged into the specified branch (or the default branch if no branch is specified)
    # v1 (broken) git branch --merged ---- only works if the repo you're working with is merging branches instead of squashing them
    #bclean = "!f() { DEFAULT=$(git default); git branch --merged ${1-$DEFAULT} | grep -v " ${1-$DEFAULT}$" | xargs git branch -d; }; f"
    # v2 (fixed) - uses gone marker to find branches that have been merged upstream
    bclean = !git gone | xargs -r git branch -D
    
    ### Switches to specified branch (or the default branch if no branch is specified), runs git up, then runs bclean.
    bdone = "!f() { DEFAULT=$(git default); git checkout ${1-$DEFAULT} && git up && git bclean ${1-$DEFAULT}; }; f"

    ### Safely push force 
    ### https://developer.atlassian.com/blog/2015/04/force-with-lease/
    pushf = push --force-with-lease

    ### Push to origin with tracking
    po = "!git push --set-upstream origin \"$(git rev-parse --abbrev-ref HEAD)\""

    ### set local git credentials based on identities set in this config file
    ### i.e.: git identity github
    identity = "! git config user.name $(git config user.$1.name); git config user.email $(git config user.$1.email); git config user.signingkey $(git config user.$1.signingkey); :"

    ### Open remote repository on default browser (for nix systems switch explorer command with open)
    #open = "!f() { REPO_URL=$(git config remote.origin.url); explorer ${REPO_URL%%.git}; }; f"
    #open = "!f() { REPO_URL=$(git config remote.origin.url | sed -e 's,:,/,g' -e 's,git@,http://,g' -e 's,.git,,g'); explorer ${REPO_URL} ; }; f"
    open = "!f(){ URL=$(git config remote.origin.url); explorer ${URL%.git}; }; f"
    browse = !git open

    ### Moves a set of commits from the current branch to another
    migrate = "!f(){ DEFAULT=$(git default); CURRENT=$(git symbolic-ref --short HEAD); git checkout -b $1 && git branch --force $CURRENT ${3-$CURRENT@{u}} && git rebase --onto ${2-$DEFAULT} $CURRENT; }; f"
    new = !git init && git symbolic-ref HEAD refs/heads/main


    set-origin = remote set-url origin
    set-upstream = remote set-url upstream
    
