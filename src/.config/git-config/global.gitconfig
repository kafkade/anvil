[user]
	name = Javier
	email = javierfe@microsoft.com

[include]
    path = ~/.aliases.gitconfig    

# [commit]
# 	gpgsign = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	ff = only
[core]
	excludesFile = ~/.gitignore
    editor = code --wait --new-window
	pager = git-split-diffs --color | less -+LFX
[pager]
	branch = false
[credential "helperselector"]
	selected = wincred

[merge]
	tool = bc
[mergetool "p4merge"]
	path = C:\\Users\\javierfe\\scoop\\apps\\p4v\\current\\p4merge.exe
[mergetool "bc"]
	path = c:/Program Files/Beyond Compare 4/bcomp.exe
[mergetool]
	keepBackup = false


[diff]
	tool = bc
[difftool "bc"]
	path = c:/Program Files/Beyond Compare 4/bcomp.exe
[difftool]
	prompt = false


### diff delta like Github
### see https://dandavison.github.io/delta/configuration.html
